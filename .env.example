# Template environment configuration (Safe to commit to GitHub)
# Copy this file to .env and configure your secret credentials

# Flask secret key for signing session cookies
SECRET_KEY=replace_with_a_secure_random_string

# Default Administrator Credentials (used when database is initialized)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@system.com
ADMIN_PHONE=+1-800-555-0199
ADMIN_PASSWORD=your_strong_admin_password_here
